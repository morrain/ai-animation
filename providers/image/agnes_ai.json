{
  "provider_name": "agnes-ai",
  "create_url": "https://apihub.agnes-ai.com/v1/images/generations",
  "method": "POST",
  "headers": {
    "Authorization": "Bearer xxx",
    "Content-Type": "application/json"
  },
  "payload_template": {
    "model": "agnes-image-2.1-flash",
    "prompt": "${PROMPT}",
    "size": "2K",
    "ratio": "16:9",
    "extra_body": {
      "response_format": "url"
    }
  },
  "img2img_payload_template": {
    "model": "agnes-image-2.1-flash",
    "prompt": "${PROMPT}",
    "size": "${SIZE}",
    "ratio": "${RATIO}",
    "extra_body": {
      "image": [
        "${REF_IMAGE_URL}"
      ],
      "response_format": "url"
    }
  },
  "async_poll": false,
  "response_image_url_path": "data.0.url"
}